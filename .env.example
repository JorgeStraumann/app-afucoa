# AFUCOA V2
# Copiá este archivo como .env.local para desarrollo.
VITE_AFUCOA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dominio interno usado como alias de login para autenticación por cédula.
# No es el correo real del socio.
VITE_AUTH_ALIAS_DOMAIN=auth.afucoa.local

# Solo para builds alojados bajo un subdirectorio (por ejemplo GitHub Pages).
# En desarrollo local y hosts con dominio propio se deja en /.
AFUCOA_PUBLIC_BASE=/
