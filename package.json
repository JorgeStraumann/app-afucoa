{
  "name": "afucoa-v2",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "node scripts/validate-staging-env.mjs && vite build --mode staging",
    "preview": "vite preview",
    "preview:staging": "vite preview --host 0.0.0.0",
    "test:staging": "pnpm run test:migrations && pnpm run test:edge-config && pnpm run test:live-auth-isolation && pnpm run build:staging && node scripts/check-staging-dist.mjs",
    "test:migrations": "node scripts/check-migration-chain.mjs",
    "test:edge-config": "node --test tests/edge-runtime-config.test.mjs && node scripts/check-edge-runtime-config.mjs",
    "test:pilot": "node --test tests/pilot-import.test.mjs",
    "test:recovery": "node --test tests/password-recovery.test.mjs tests/password-recovery-handlers.test.mjs",
    "test:session": "node --test tests/session-regression.test.mjs",
    "test:live-auth-isolation": "node --test tests/live-auth-isolation.test.mjs",
    "test:push": "node --test tests/push.test.mjs",
    "test:navigation": "node --test tests/navigation-access.test.mjs",
    "test:push-http": "node tests/push-http-live.mjs",
    "test:session-live": "node tests/session-regression-live.mjs",
    "test:auth-roles": "node tests/auth-roles-live.mjs",
    "test:recovery-http": "node tests/password-recovery-http-live.mjs",
    "test:rls": "node tests/rls-live-check.mjs",
    "test:integration": "node tests/supabase-integration-live.mjs"
  },
  "devDependencies": {
    "vite": "7.1.3",
    "web-push": "3.6.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "qrcode": "1.5.4"
  }
}
